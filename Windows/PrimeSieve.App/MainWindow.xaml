<Window x:Class="PrimeSieve.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="PrimeSieve" Width="1260" Height="900" MinWidth="1100" MinHeight="840" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing">
 <Grid Background="#F5F6F8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#20242B" Padding="22,28,18,20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="PrimeSieve" FontSize="28" FontWeight="Bold" Foreground="White"/>
     <TextBlock Text="VERIFIED SIEVES. MANY LANGUAGES." FontSize="10" Foreground="#FF8B57" Margin="0,7,0,26"/>
     <TextBlock Text="LANGUAGES" Foreground="#B5BECD" FontWeight="SemiBold" FontSize="11"/>
     <TextBlock Text="{Binding ReadySummary}" Foreground="#D3D9E2" Margin="0,8,0,12"/>
     <WrapPanel Margin="0,0,0,15" IsEnabled="{Binding IsIdle}">
      <Button Content="All ready" Click="SelectAll" Padding="10,6" FontSize="12"/>
      <Button Content="None" Click="SelectNone" Padding="10,6" FontSize="12"/>
      <Button Content="Refresh" Click="RefreshClicked" Padding="10,6" Margin="0" FontSize="12"/>
     </WrapPanel>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Local benchmarks • verified results" Foreground="#B5BECD" FontSize="11" Margin="0,18,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <ItemsControl ItemsSource="{Binding Languages}" IsEnabled="{Binding IsIdle}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Status.Available}" Foreground="White" Margin="0,0,0,12" ToolTip="{Binding Status.Version}">
        <StackPanel><TextBlock Text="{Binding Status.Name}"/><TextBlock Text="{Binding Badge}" Foreground="#B5BECD" FontSize="10"/></StackPanel>
       </CheckBox>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,20"><TextBlock Text="Compare prime calculation" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Compare named sieve implementations in independent processes." Foreground="#657083" Margin="0,7,0,0"/></StackPanel>
   <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,20">
    <StackPanel>
     <WrapPanel IsEnabled="{Binding IsIdle}" Margin="0,0,0,10">
      <ComboBox x:Name="WorkloadBox" Width="185" SelectedIndex="0" Margin="0,0,10,0" AutomationProperties.Name="Workload"><ComboBoxItem Content="First N primes"/><ComboBoxItem Content="Inclusive upper limit"/></ComboBox>
      <ComboBox x:Name="VariantBox" Width="145" SelectedIndex="0" Margin="0,0,10,0" AutomationProperties.Name="Implementations"><ComboBoxItem Content="Baselines"/><ComboBoxItem Content="Tuned variants"/><ComboBoxItem Content="All variants"/></ComboBox>
      <Button Content="Drag Race preset" Click="DragRaceClicked" Padding="10,6"/>
     </WrapPanel>
     <WrapPanel IsEnabled="{Binding IsIdle}">
      <StackPanel Margin="0,0,18,12"><TextBlock Text="Count / upper limit" Margin="0,0,0,6"/><TextBox x:Name="PrimeCountBox" Text="100000" Width="130" AutomationProperties.Name="Prime count"/></StackPanel>
      <StackPanel Margin="0,0,18,12"><TextBlock Text="Timing" Margin="0,0,0,6"/><ComboBox x:Name="ModeBox" Width="190" SelectedIndex="0" SelectionChanged="ModeChanged" AutomationProperties.Name="Timing mode"><ComboBoxItem Content="Calculation"/><ComboBoxItem Content="Startup + calculation"/><ComboBoxItem Content="Sieve throughput"/></ComboBox></StackPanel>
      <StackPanel Margin="0,0,18,12"><TextBlock Text="Iterations" Margin="0,0,0,6"/><TextBox x:Name="IterationsBox" Text="7" Width="65" AutomationProperties.Name="Iterations"/></StackPanel>
      <StackPanel Margin="0,0,18,12"><TextBlock Text="Warm-ups" Margin="0,0,0,6"/><TextBox x:Name="WarmupsBox" Text="3" Width="65" AutomationProperties.Name="Warm-ups"/></StackPanel>
      <StackPanel Margin="0,0,0,12"><TextBlock Text="Timeout (s)" Margin="0,0,0,6"/><TextBox x:Name="TimeoutBox" Text="120" Width="80" AutomationProperties.Name="Timeout seconds" ToolTip="Covers startup, warm-ups, all windows, final-pass overrun, verification and output. Start with twice the window total (at least 30 seconds); slow runtimes may need more."/></StackPanel>
     </WrapPanel>
     <Expander Header="Rounds and window duration" IsEnabled="{Binding IsIdle}" Margin="0,0,0,6"><WrapPanel Margin="0,8,0,0">      <TextBlock Text="Rounds" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="RoundsBox" Text="1" Width="40" Margin="0,0,10,0"/>
      <TextBlock Text="Seconds/window" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="SecondsBox" Text="5" Width="75" Margin="0,0,10,0"/>
</WrapPanel></Expander>
     <DockPanel Margin="0,6,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StartButton" Content="Start comparison" Click="StartClicked" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" IsEnabled="{Binding IsIdle}"/><Button Content="Cancel" Click="CancelClicked" IsEnabled="{Binding CanCancel}" Margin="0"/></StackPanel>
      <WrapPanel IsEnabled="{Binding IsIdle}"><Button Content="1K" Tag="1000" Click="PresetClicked" Padding="10,8"/><Button Content="100K" Tag="100000" Click="PresetClicked" Padding="10,8"/><Button Content="1M" Tag="1000000" Click="PresetClicked" Padding="10,8"/></WrapPanel>
     </DockPanel>
    </StackPanel>
   </Border>
   <TabControl x:Name="MainTabs" Grid.Row="2" Background="White" BorderBrush="#E0E4EA">
    <TabItem Header="Results">
     <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="StorageFilter" SelectedIndex="0" Width="120" Margin="0,0,10,0" SelectionChanged="StorageChanged"><ComboBoxItem Content="All storage"/><ComboBoxItem Content="Byte flags"/><ComboBoxItem Content="Packed bits"/></ComboBox><Button Content="Details" Click="ResultDetailsClicked" Padding="10,6"/><Button Content="Export JSON" Click="ExportJsonClicked" IsEnabled="{Binding CanExport}" Padding="10,6"/><Button Content="Export CSV" Click="ExportCsvClicked" IsEnabled="{Binding CanExport}" Padding="10,6" Margin="0"/></StackPanel><StackPanel><TextBlock Text="{Binding ResultHeading}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Median score • details on double-click" Foreground="#657083" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel>
      <Grid Grid.Row="1"><DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" MouseDoubleClick="ResultDoubleClicked" KeyDown="ResultKeyDown" SelectionMode="Single">
       <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ResultText}" Header="Implementation" Binding="{Binding DisplayName}" Width="*" MinWidth="120"/><DataGridTextColumn ElementStyle="{StaticResource ResultText}" Header="Score" Binding="{Binding ScoreDisplay}" Width="155"/><DataGridTextColumn ElementStyle="{StaticResource ResultText}" Header="IQR" Binding="{Binding SpreadDisplay}" Width="130"/><DataGridTextColumn ElementStyle="{StaticResource ResultText}" Header="Samples" Binding="{Binding Iterations}" Width="80"/><DataGridTemplateColumn Header="Relative" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock VerticalAlignment="Center" Margin="8,0"><TextBlock.Text><MultiBinding Converter="{StaticResource RelativeTime}"><Binding Path="RankingCost"/><Binding Path="DataContext.Results[0].RankingCost" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
      </DataGrid><TextBlock Text="Select languages, choose a workload, and start a comparison.&#10;Only verified results appear here." TextAlignment="Center" Foreground="#657083" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Results.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <TextBox Grid.Row="2" Text="{Binding ResultNotes, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" Foreground="#657083" FontSize="12"/>
     </Grid>
    </TabItem>
    <TabItem Header="Code explorer">
     <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="A−" Click="SmallerCode" Padding="9,5"/><Button Content="A+" Click="LargerCode" Padding="9,5"/><Button Content="Copy code" Click="CopyCode" Padding="10,5" Margin="0"/></StackPanel><ComboBox x:Name="CodeLanguage" Width="470" HorizontalAlignment="Left" DisplayMemberPath="DisplayName" SelectionChanged="CodeSelectionChanged"/></DockPanel>
      <TextBlock Grid.Row="1" x:Name="CodeSummary" Text="Calculation excerpts from the bundled worker." TextWrapping="Wrap" Foreground="#657083" Margin="0,12,0,12" FontSize="12"/>
      <TextBox Grid.Row="2" x:Name="CodeText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="14" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#20242B" Foreground="#E8EBF0" Padding="18"/>
     </Grid>
    </TabItem>
    <TabItem Header="History">
     <DockPanel Margin="16"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Open comparison" Click="OpenHistory" IsEnabled="{Binding IsIdle}"/><Button Content="Clear history…" Click="ClearHistory" IsEnabled="{Binding CanClearHistory}"/></StackPanel><ListBox x:Name="HistoryList" ItemsSource="{Binding History}" DisplayMemberPath="Summary" MouseDoubleClick="HistoryDoubleClicked"/></DockPanel>
    </TabItem>
    <TabItem Header="Language setup">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" IsEnabled="{Binding IsIdle}">
      <TextBlock Text="Runtime executables" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Toolchains are installed separately. A successful version check means a runtime was detected; its worker is compiled and verified when you run it." TextWrapping="Wrap" Foreground="#657083" Margin="0,8,0,18"/>
      <ComboBox x:Name="SetupLanguage" DisplayMemberPath="Name" SelectionChanged="SetupSelectionChanged"/>
      <TextBlock x:Name="SetupAdvice" TextWrapping="Wrap" Margin="0,16,0,12"/>
      <TextBox x:Name="RuntimePath" AutomationProperties.Name="Runtime executable path"/>
      <WrapPanel Margin="0,12,0,16"><Button Content="Browse…" Click="BrowseRuntime"/><Button Content="Save and refresh" Click="SaveRuntime"/><Button Content="Use automatic detection" Click="ResetRuntime"/></WrapPanel>
      <TextBox x:Name="SetupStatus" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"/>
      <Separator Margin="0,18,0,18"/>
      <TextBlock Text="Measurement rules" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Calculation includes fresh allocation, initialization, marking, and scanning. Warm-ups are excluded. Startup timing launches a fresh worker for every iteration and includes startup, checksums, and output. Compilation is recorded separately.&#10;&#10;Implementations run one at a time, shuffled anew each round. Throughput counts fresh sieve passes in wall-clock windows; result scanning is outside each window, and the retained final sieve is verified. The Drag Race preset uses a limit of 1,000,000 and three five-second windows. Each result must match an independent reference count, last prime, and checksum. Background activity and runtime storage differences can affect comparisons. Small timing differences are not definitive wins." TextWrapping="Wrap" Foreground="#657083" Margin="0,10,0,0"/>
     </StackPanel></ScrollViewer>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="{Binding PreferencesWarning}" TextWrapping="Wrap" Foreground="#9B3600" MaxHeight="65" ToolTip="{Binding PreferencesWarning}"/><ProgressBar Height="4" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Foreground="#657083" FontSize="12" Margin="0,9,0,0"/></StackPanel>
  </Grid>
 </Grid>
</Window>
